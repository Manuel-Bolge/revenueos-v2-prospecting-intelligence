      "name": "Simulate Incoming Prospect "
    },
    {
      "parameters": {
        "jsCode": "\nreturn $input.all().map(item => {\n  const data = item.json;\n\n  // Normalize company website into a domain\n  const domain = String(data.website || \"\")\n    .trim()\n    .toLowerCase()\n    .replace(/^https?:\\/\\//, \"\")\n    .replace(/^www\\./, \"\")\n    .split(\"?\")[0]\n.split(\"#\")[0]\n.split(\"/\")[0]\n    .split(\":\")[0];\n\n  // Normalize email\n  const email = String(data.email || \"\")\n    .trim()\n    .toLowerCase();\n\n  return {\n    json: {\n      ...data,\n      domain,\n      email\n    }\n  };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -416,
        144
      ],
